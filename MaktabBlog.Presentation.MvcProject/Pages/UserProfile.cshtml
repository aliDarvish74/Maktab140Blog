@page
@model MaktabBlog.Presentation.MvcProject.Pages.UserProfile
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="stylesheet" href="css/user-profile-style.css"/>
	<title>Maktab Blog</title>
</head>
<body>
<div class="container">
	<div class="row gutters align-content-center">
		<div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
			<div class="card h-100">
				<div class="card-body">
					<div class="account-settings">
						<div class="user-profile">
							<div class="user-avatar">
								<img src="https://bootdey.com/img/Content/avatar/avatar1.png" alt="Maxwell Admin">
							</div>
							<h5 class="user-name">@Model.UserProfileModel.FullName</h5>
							<h6 class="user-email">@Model.UserProfileModel.NationalCode</h6>
							<h6 class="user-name">@Model.UserProfileModel.Age</h6>
						</div>
						<div class="about">
							<h5 class="mb-2 text-primary">About</h5>
							<p>I'm Yuki. Full Stack Designer I enjoy creating user-centric, delightful and human experiences.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<form class="w-50" method="post">
			<div class="mb-3">
				<label asp-for="@Model.UserProfileModel.FullName" class="form-label">FullName</label>
				<input asp-for="@Model.UserProfileModel.FullName" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
				<div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
			</div>
			<div class="mb-3">
				<label asp-for="@Model.UserProfileModel.Age" class="form-label">Age</label>
				<input type="password" asp-for="@Model.UserProfileModel.Age" class="form-control" id="exampleInputPassword1">
			</div>
			<input type="text" asp-for="@Model.UserProfileModel.NationalCode" hidden value="@Model.UserProfileModel.NationalCode"/>
			<input type="text" asp-for="@Model.UserProfileModel.Id" value="@Model.UserProfileModel.Id" hidden/>
			<button type="submit" class="btn btn-primary">Submit</button>
		</form>
	</div>
</div>

</body>
</html>

