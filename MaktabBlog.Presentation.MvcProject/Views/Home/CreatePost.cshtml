@model MaktabBlog.Presentation.MvcProject.Models.Posts.CreatePostRequestVm

@{
  ViewData["Title"] = "Create new post";
  Layout = "_Layout";
}

<form asp-action="CreatePost" method="post" class="needs-validation col-md-12">
  <div class="mb-3 w-25">
    <label asp-for="@Model.Title">Title</label>
    <div class="input-group">
      <input asp-for="@Model.Title">
    </div>
  </div>

  <div class="mb-3">
    <label asp-for="@Model.Content">Content</label>
    <textarea asp-for="@Model.Content" cols="50" rows="15"></textarea>
  </div>

  <hr class="mb-4">
  <button class="btn btn-primary btn-lg btn-block" type="submit">Create!</button>
</form>
