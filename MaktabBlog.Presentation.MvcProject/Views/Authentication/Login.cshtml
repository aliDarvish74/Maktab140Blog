  const viewDataValue = `@TempData["HasError"]`;
  console.log(viewDataValue);
  if (viewDataValue?.toString() === true.toString()) {
    console.log(@TempData["Error"])
  }
</script>*@
<script src="/js/login-script.js"></script>
<script>
  const hasError = @(TempData["HasError"]?.ToString().ToLower() ?? "false");

  if (hasError) {
    const message = `@(TempData["Error"]?.ToString())`;
    showToast(message);
  }
</script>
</body>
</html>

