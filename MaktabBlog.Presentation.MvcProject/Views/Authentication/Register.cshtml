@model MaktabBlog.Presentation.MvcProject.Models.Authentications.RegisterUserVm
@{
  Layout = null;
}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register</title>
    <meta
      name="description"
      content="Dark-theme login form with glowing neon accents, parallax orbs and crisp focus states."
    />
    <meta name="author" content="Aigars Silkalns / Colorlib" />
    <link
      rel="canonical"
      href="https://preview.colorlib.com/theme/login-forms/forms/neon/"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Neon Minimalist Login Form" />
    <meta
      property="og:description"
      content="Dark-theme login form with glowing neon accents, parallax orbs and crisp focus states."
    />
    <meta
      property="og:url"
      content="https://preview.colorlib.com/theme/login-forms/forms/neon/"
    />
    <meta
      property="og:image"
      content="https://preview.colorlib.com/theme/login-forms/assets/screenshots/neon.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Neon Minimalist Login Form" />
    <meta
      name="twitter:description"
      content="Dark-theme login form with glowing neon accents, parallax orbs and crisp focus states."
    />
    <meta
      name="twitter:image"
      content="https://preview.colorlib.com/theme/login-forms/assets/screenshots/neon.png"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />

    <link rel="stylesheet" href="/css/register-style.css" />
  </head>
  <body>
    <div class="login-container">
      <div class="login-card">
        <div class="login-header">
          <div class="logo-icon">⚡</div>
          <h2>Sign up</h2>
          <p>Create new account</p>
        </div>

        <form class="login-form" id="loginForm" asp-controller="Authentication" asp-action="Register">
          <div class="form-group">
            <div class="input-wrapper">
              <input
                asp-for="@Model.FirstName"
                required
                autocomplete="first-name"
              />
              <label asp-for="@Model.FirstName">First Name</label>
              <span class="input-line"></span>
            </div>
            <span class="error-message" id="firstNameError"></span>
          </div>

          <div class="form-group">
            <div class="input-wrapper">
              <input
                asp-for="@Model.LastName"
                required
                autocomplete="last-name"
              />
              <label asp-for="@Model.LastName">Last Name</label>
              <span class="input-line"></span>
            </div>
            <span class="error-message" id="lastNameError"></span>
          </div>

          <div class="form-group">
            <div class="input-wrapper">
              <input
                asp-for="@Model.NationalId"
                required
                autocomplete="national-id"
              />
              <label asp-for="@Model.NationalId">National ID</label>
              <span class="input-line"></span>
            </div>
            <span class="error-message" id="nationalIdError"></span>
          </div>

          <div class="form-group">
            <div class="input-wrapper">
              <input
                asp-for="@Model.Age"
                required
                autocomplete="age"
              />
              <label asp-for="@Model.Age">Age</label>
              <span class="input-line"></span>
            </div>
            <span class="error-message" id="ageError"></span>
          </div>

          <div class="form-group">
            <div class="input-wrapper password-wrapper">
              <input asp-for="@Model.Password" required />
              <label asp-for="@Model.Password">Password</label>
              <button
                type="button"
                class="password-toggle"
                id="passwordToggle"
                aria-label="Toggle password visibility"
              >
                <span class="toggle-icon"></span>
              </button>
              <span class="input-line"></span>
            </div>
            <span class="error-message" id="passwordError"></span>
          </div>

          <div class="form-group">
            <div class="input-wrapper password-wrapper">
              <input
                type="password"
                id="repassword"
                name="repassword"
                required
              />
              <label for="repassword">Confirm Password</label>
              <button
                type="button"
                class="password-toggle"
                id="repasswordToggle"
                aria-label="Toggle repassword visibility"
              >
                <span class="toggle-icon"></span>
              </button>
              <span class="input-line"></span>
            </div>
            <span class="error-message" id="repasswordError"></span>
          </div>

          <button id="sign-up" type="submit" class="login-btn btn">
            <span class="btn-text">Sign Up</span>
            <span class="btn-loader"></span>
            <span class="btn-glow"></span>
          </button>
        </form>

        <div class="divider">
          <span>or</span>
        </div>

        <div class="signup-link">
          <p>
            Already has an account? <a asp-controller="Authentication" asp-action="Login">Sign In</a>
          </p>
        </div>

        <div class="success-message" id="successMessage">
          <div class="success-icon">✓</div>
          <h3>Welcome back!</h3>
          <p>Redirecting to your dashboard...</p>
        </div>
      </div>

      <div class="background-effects">
        <div class="glow-orb glow-orb-1"></div>
        <div class="glow-orb glow-orb-2"></div>
        <div class="glow-orb glow-orb-3"></div>
      </div>
    </div>
    <div
      id="error-toast"
      class="toast align-items-center text-bg-danger border-0"
      role="alert"
      aria-live="assertive"
      aria-atomic="true"
    >
      <div class="d-flex">
        <div id="error-toast-body" class="toast-body"></div>
        <button
          type="button"
          class="btn-close btn-close-white me-2 m-auto"
          data-bs-dismiss="toast"
          aria-label="Close"
        ></button>
      </div>
    </div>
    <div
      id="success-toast"
      class="toast align-items-center text-bg-success border-0"
      role="alert"
      aria-live="assertive"
      aria-atomic="true"
    >
      <div class="d-flex">
        <div id="success-toast-body" class="toast-body"></div>
        <button
          type="button"
          class="btn-close btn-close-white me-2 m-auto"
          data-bs-dismiss="toast"
          aria-label="Close"
        ></button>
      </div>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>

    <script src="/js/register-script.js"></script>
  </body>
</html>



